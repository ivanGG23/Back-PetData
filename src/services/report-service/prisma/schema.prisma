generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ESTADO_ANIMAL {
  id          Int       @id
  nombre      String
  descripcion String
  reportes    REPORTS[]
}

model ESTADO_REPORTE {
  id          Int       @id
  nombre      String
  descripcion String
  reportes    REPORTS[]
}

model PRIORIDAD {
  id       Int       @id
  nombre   String
  nivel    Int
  reportes REPORTS[]
}

model REPORTS {
  id                    Int       @id @default(autoincrement())
  usuario_creador_id    Int
  rescatista_id         Int?
  estado_animal_id      Int
  estado_reporte_actual Int
  prioridad_id          Int
  tipo_animal_id        Int
  descripcion           String
  fecha_creacion        DateTime  @default(now())
  fecha_asig            DateTime?
  fecha_cierre          DateTime?
  contacto_opcional     String?

  estado_animal  ESTADO_ANIMAL  @relation(fields: [estado_animal_id],  references: [id])
  estado_reporte ESTADO_REPORTE @relation(fields: [estado_reporte_actual], references: [id])
  prioridad      PRIORIDAD      @relation(fields: [prioridad_id],       references: [id])
  tipo_animal    TIPO_ANIMAL    @relation(fields: [tipo_animal_id],     references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tipo_animal")

  // ── Relaciones nuevas ──────────────────────────────────────────────────────
  locacion  LOCACION?
  direccion DIRECCION?
}

model TIPO_ANIMAL {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String
  reportes    REPORTS[]
}

model LOCACION {
  id               Int       @id @default(autoincrement())
  reporte_id       Int       @unique
  latitud          Decimal   @db.Decimal(10, 7)
  longitud         Decimal   @db.Decimal(10, 7)
  precision_metros Decimal?  @db.Decimal(6, 2)
  fecha_subido     DateTime  @default(now())

  reporte REPORTS @relation(fields: [reporte_id], references: [id])
}

model DIRECCION {
  id           Int       @id @default(autoincrement())
  reporte_id   Int       @unique
  pais         String?
  estado       String?
  ciudad       String?
  municipio    String?
  colonia      String?
  barrio       String?
  display_name String?
  fecha_subido DateTime  @default(now())

  reporte REPORTS @relation(fields: [reporte_id], references: [id])
}